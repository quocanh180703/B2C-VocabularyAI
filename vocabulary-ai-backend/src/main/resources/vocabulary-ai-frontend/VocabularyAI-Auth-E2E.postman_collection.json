{
  "info": {
    "name": "VocabularyAI Authentication E2E",
    "description": "Complete E2E authentication testing collection for VocabularyAI backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Setup Variables",
      "item": [
        {
          "name": "Set Base URL",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set environment variables for testing",
                  "pm.environment.set('base_url', 'http://localhost:8080');",
                  "pm.environment.set('api_path', '/api/auth');",
                  "",
                  "// Test user data",
                  "pm.environment.set('test_email', 'testuser' + Date.now() + '@example.com');",
                  "pm.environment.set('test_username', 'testuser' + Date.now());",
                  "pm.environment.set('test_password', 'Password@123');",
                  "pm.environment.set('test_fullname', 'Test User');",
                  "",
                  "// Existing user for login test",
                  "pm.environment.set('login_email', 'admin@example.com');",
                  "pm.environment.set('login_password', 'Admin@123');",
                  "",
                  "console.log('Variables initialized:', {",
                  "  base_url: pm.environment.get('base_url'),",
                  "  api_path: pm.environment.get('api_path'),",
                  "  test_email: pm.environment.get('test_email'),",
                  "  test_username: pm.environment.get('test_username')",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "1. LOGIN",
      "item": [
        {
          "name": "Login with Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "console.log('Login Test - Email:',  pm.environment.get('login_email'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
                  "console.log('Response Body:', pm.response.text());",
                  "",
                  "// Parse response",
                  "const jsonData = pm.response.json();",
                  "",
                  "// Verify response structure",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has access_token', function () {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "    pm.expect(jsonData.access_token).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Response has refresh_token', function () {",
                  "    pm.expect(jsonData).to.have.property('refresh_token');",
                  "    pm.expect(jsonData.refresh_token).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Response has token_type Bearer', function () {",
                  "    pm.expect(jsonData.token_type).to.equal('Bearer');",
                  "});",
                  "",
                  "pm.test('Response has expires_in', function () {",
                  "    pm.expect(jsonData.expires_in).to.equal(3600000);",
                  "});",
                  "",
                  "pm.test('Response has user object', function () {",
                  "    pm.expect(jsonData.user).to.be.an('object');",
                  "    pm.expect(jsonData.user).to.have.property('id');",
                  "    pm.expect(jsonData.user).to.have.property('username');",
                  "    pm.expect(jsonData.user).to.have.property('email');",
                  "    pm.expect(jsonData.user).to.have.property('role');",
                  "    pm.expect(jsonData.user).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('User status is ACTIVE', function () {",
                  "    pm.expect(jsonData.user.status).to.equal('ACTIVE');",
                  "});",
                  "",
                  "// Save tokens for later use",
                  "pm.environment.set('access_token', jsonData.access_token);",
                  "pm.environment.set('refresh_token', jsonData.refresh_token);",
                  "pm.environment.set('user_id', jsonData.user.id);",
                  "",
                  "console.log('Tokens saved:', {",
                  "  access_token: jsonData.access_token.substring(0, 20) + '...',",
                  "  refresh_token: jsonData.refresh_token.substring(0, 20) + '...',",
                  "  user_id: jsonData.user.id",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrUsername\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. REGISTER (2-STEP OTP)",
      "item": [
        {
          "name": "Step 1: Validate Register (Send OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
                  "console.log('Response Body:', pm.response.text());",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has message', function () {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});",
                  "",
                  "// In real scenario, OTP would be sent via email",
                  "// For testing, we use hardcoded OTP or get from logs",
                  "pm.environment.set('register_otp', '000000');",
                  "",
                  "console.log('Step 1 Complete - OTP should be sent to email');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\",\n  \"fullName\": \"{{test_fullname}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/register/validate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "register",
                "validate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Step 2: Verify OTP Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
                  "console.log('Response Body:', pm.response.text());",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has message', function () {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});",
                  "",
                  "console.log('Step 2 Complete - Registration successful, user can now login');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"{{register_otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/register/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "register",
                "verify-otp"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. FORGOT PASSWORD (3-STEP OTP)",
      "item": [
        {
          "name": "Step 1: Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
