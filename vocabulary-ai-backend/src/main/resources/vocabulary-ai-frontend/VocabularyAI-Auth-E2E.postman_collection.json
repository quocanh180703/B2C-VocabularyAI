            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/forgot-password/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "forgot-password",
                "send-otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Step 2: Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
                  "console.log('Response Body:', pm.response.text());",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has resetToken', function () {",
                  "    pm.expect(jsonData).to.have.property('resetToken');",
                  "});",
                  "",
                  "pm.environment.set('reset_token', jsonData.resetToken);",
                  "",
                  "console.log('Step 2 Complete - Reset token received');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"otp\": \"{{forgot_otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/forgot-password/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "forgot-password",
                "verify-otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Step 3: Reset Password (AUTO-LOGIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
                  "console.log('Response Body:', pm.response.text());",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has access_token (AUTO-LOGIN)', function () {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});",
                  "",
                  "pm.test('Response has refresh_token', function () {",
                  "    pm.expect(jsonData).to.have.property('refresh_token');",
                  "});",
                  "",
                  "pm.environment.set('access_token', jsonData.access_token);",
                  "pm.environment.set('refresh_token', jsonData.refresh_token);",
                  "",
                  "console.log('Step 3 Complete - Password reset + AUTO-LOGIN successful');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"newPassword\": \"NewPassword@123\",\n  \"resetToken\": \"{{reset_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/forgot-password/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "forgot-password",
                "reset"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. TOKEN REFRESH",
      "item": [
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
                  "console.log('Response Body:', pm.response.text());",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has new access_token', function () {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "    pm.expect(jsonData.access_token).to.not.equal(pm.environment.get('access_token'));",
                  "});",
                  "",
                  "pm.test('Response has new refresh_token', function () {",
                  "    pm.expect(jsonData).to.have.property('refresh_token');",
                  "});",
                  "",
                  "pm.environment.set('access_token', jsonData.access_token);",
                  "pm.environment.set('refresh_token', jsonData.refresh_token);",
                  "",
                  "console.log('Token refresh successful');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "refresh"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. LOGOUT",
      "item": [
        {
          "name": "Logout (Revoke Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Status:', pm.response.code);",
                  "console.log('Response Body:', pm.response.text());",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Response has success message', function () {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});",
                  "",
                  "console.log('Logout successful - token revoked');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_path}}",
                "logout"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. ERROR HANDLING",
      "item": [
        {
          "name": "Login with Invalid Email",
          "event": [
