                  "",
                  "pm.test('Response has message', function () {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});",
                  "",
                  "pm.environment.set('forgot_otp', '000000');",
                  "",
                  "console.log('Step 1 Complete - OTP sent to email');"
