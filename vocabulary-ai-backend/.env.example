# ============================================================
# VocabularyAI Backend - Environment Variables (Development)
# ============================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
# Database: datn_2 (as configured in application.yml)
DB_USERNAME=root
DB_PASSWORD=180703

# Email Configuration - Gmail SMTP (Updated from Mailtrap)
# To use Gmail:
# 1. Enable 2-Factor Authentication: https://accounts.google.com/signin/v2/challenge/selection
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Copy the 16-character password (remove spaces)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Frontend URL (for payment success email CTA button)
FRONTEND_URL=http://localhost:3000

# Redis Configuration (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars-abcdefgh
JWT_ACCESS_TOKEN_EXPIRY=3600000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# Cloudinary Configuration (Audio Storage)
CLOUDINARY_URL=cloudinary://347852754341328:ysYZFQwFWNvSR8WgrOyVMcHc8Zk@dzb6rfaxt

# Gemini AI Configuration
GEMINI_API_KEY=AQ.Ab8RN6IsF4fZgu5DD1QIR_quqjvbzaWFpGX0kRUQPgYQENp2Fw

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Application name
APP_NAME=VocabularyAI

# Development Tools
SPRING_DEVTOOLS_RESTART_ENABLED=true

# Logging
LOG_LEVEL=DEBUG

# Speech-to-Text (Vilao AI Whisper / OpenAI-compatible)
WHISPER_URL=https://api.vilao.ai/v1/audio/transcriptions
WHISPER_API_KEY=your-vilao-or-openai-api-key
WHISPER_MODEL=tsa/groq/whisper-large-v3
WHISPER_LANGUAGE=en

# Text-to-Speech (TTS)
TTS_URL=https://api.xah.io/v1/audio/speech
TTS_API_KEY=your-tts-api-key
TTS_MODEL=namth/grok-voice-latest
TTS_VOICE=alloy

# AI Chat / Grok (xah.io)
AI_CHAT_URL=https://api.xah.io/v1/chat/completions
AI_CHAT_API_KEY=your-ai-chat-api-key
AI_CHAT_MODEL=thanhnhan9023/grok-4.6

# Payment Module (PayOS)
PAYOS_API_KEY=your-payos-api-key
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_SANDBOX=true

