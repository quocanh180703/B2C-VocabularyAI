# ============================================================
# VocabularyAI Backend - Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control!
#
# Usage:
# 1. Create .env file in project root
# 2. Fill in your actual configuration values
# 3. Load environment variables before running the app
#
# On Linux/Mac:
#   export $(cat .env | xargs)
#
# On Windows PowerShell:
#   Get-Content .env | ForEach-Object { $name, $value = $_.Split('='); [Environment]::SetEnvironmentVariable($name, $value) }
#
# Or use IDE features to load .env automatically
# ============================================================

# ============================================================
# 1. Server Configuration
# ============================================================
SERVER_PORT=8080

# ============================================================
# 2. Database Configuration (MySQL)
# ============================================================
DB_USERNAME=root
DB_PASSWORD=root
# DB_URL=jdbc:mysql://localhost:3306/vocabulary_ai?useSSL=false&serverTimezone=UTC

# ============================================================
# 3. Email Configuration (SMTP)
# ============================================================

# === Mailtrap (DEPRECATED - Replaced with Gmail) ===
# Previous provider - no longer used
# EMAIL_SMTP_HOST=smtp.mailtrap.io
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=your-mailtrap-username
# EMAIL_PASSWORD=your-mailtrap-password

# === Gmail SMTP (Current Provider) ===
# Generate App Password: https://myaccount.google.com/apppasswords
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Copy the 16-character app password
# Format: xxxx xxxx xxxx xxxx (remove spaces when using)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# === SendGrid (Alternative for Production) ===
# Uncomment below if using SendGrid instead of Gmail
# Visit: https://sendgrid.com
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key-here

# Application email display name
APP_NAME=VocabularyAI
EMAIL_FROM=noreply@vocabularyai.com

# ============================================================
# 4. Frontend Configuration
# ============================================================
# Frontend URL for payment success email CTA button
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ============================================================
# 5. Redis Configuration (Cache)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# 6. JWT Configuration
# ============================================================
# Generate a strong secret key (min 256 bits / 32 characters)
# Command: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_ACCESS_TOKEN_EXPIRY=3600000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# ============================================================
# 7. Cloudinary Configuration (Audio Storage)
# ============================================================
# Format: cloudinary://api_key:api_secret@cloud_name
# Visit: https://cloudinary.com
# Get your URL from: Account > Account Details > Copy your API Environment variable
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ============================================================
# 7.1 Gemini AI Configuration
# ============================================================
# Get API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# 7.2 OpenAI Whisper Configuration (Speech-to-Text)
# ============================================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# 7.3 PayOS Configuration (Payment Gateway)
# ============================================================
# Get credentials from: https://payos.vn/
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CLIENT_ID=your_payos_client_id_here

# ============================================================
# 8. Application Profile
# ============================================================
# Options: dev, prod, test
# dev: Development with full logging and schema auto-update
# prod: Production with minimal logging and schema validation
# test: Test environment
SPRING_PROFILES_ACTIVE=dev

# ============================================================
# 9. OTP Configuration
# ============================================================
# OTP length (usually 6 digits)
OTP_LENGTH=6
# OTP expiry in minutes
OTP_EXPIRY_MINUTES=5
# Maximum OTP attempts before locking
OTP_MAX_ATTEMPTS=5

# ============================================================
# 10. Additional Configuration
# ============================================================
# Application name
APP_NAME=VocabularyAI

# ============================================================
# 11. Development Tools Configuration (Optional)
# ============================================================
# Enable Spring DevTools auto-restart
SPRING_DEVTOOLS_RESTART_ENABLED=true

# ============================================================
# 12. Logging Configuration (Optional)
# ============================================================
# Log levels: TRACE, DEBUG, INFO, WARN, ERROR, FATAL
LOG_LEVEL=DEBUG
