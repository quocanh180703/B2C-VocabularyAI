# ========================================
# VocabularyAI Backend - Environment Variables
# ========================================
# Copy file này thành .env và điền các giá trị thực
# Do NOT commit .env file vào Git!
# ========================================

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_PASSWORD=180703

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8080

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_SECRET=vocabulary-ai-secret-key-change-in-production-environment-please
JWT_REFRESH_SECRET=vocabulary-ai-refresh-secret-key-change-in-production-environment-please

# ========================================
# GEMINI AI CONFIGURATION
# ========================================
GEMINI_API_KEY=AQ.Ab8RN6IsF4fZgu5DD1QIR_quqjvbzaWFpGX0kRUQPgYQENp2Fw

# ========================================
# SPEAKING MODULE - AUDIO STORAGE
# ========================================
# Storage type: local, cloudinary, s3
AUDIO_STORAGE_TYPE=cloudinary

# Local storage path (nếu AUDIO_STORAGE_TYPE=local)
AUDIO_STORAGE_LOCAL_PATH=/tmp/vocabulary-ai/audio

# ========================================
# CLOUDINARY CONFIGURATION
# ========================================
# Lấy URL từ Cloudinary Dashboard: Settings > Account > API Environment variable
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://347852754341328:ysYZFQwFWNvSR8WgrOyVMcHc8Zk@dzb6rfaxt

# Cloudinary folder để organize media files
CLOUDINARY_FOLDER=vocabulary-ai

# Resource type: raw, video, image, auto
# Dùng "raw" cho audio files
CLOUDINARY_RESOURCE_TYPE=raw

# ========================================
# AWS S3 CONFIGURATION (nếu cần)
# ========================================
# Storage type: s3
# AWS_S3_BUCKET=vocabulary-ai-audio
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ========================================
# SPEECH-TO-TEXT CONFIGURATION
# ========================================
STT_PROVIDER=google_rest
STT_LANGUAGE_CODE=en-US
# STT_API_KEY=your-stt-api-key (optional)

# ========================================
# TEXT-TO-SPEECH CONFIGURATION
# ========================================
TTS_PROVIDER=google_rest
TTS_LANGUAGE_CODE=en-US
TTS_VOICE_NAME=en-US-Neural2-C
# TTS_API_KEY=your-tts-api-key (optional)

# ========================================
# PRONUNCIATION ANALYSIS
# ========================================
PRONUNCIATION_PROVIDER=gemini
