# ============================================================
# VocabularyAI Backend - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# 1. Server Configuration
SERVER_PORT=8080

# 2. Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=datn_2
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# 3. Email Configuration - SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# 4. Frontend URL
FRONTEND_URL=http://localhost:3000

# 5. Redis Configuration (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 6. JWT Security (Minimum 256 bits for HS256)
JWT_SECRET=your_jwt_access_secret_key_minimum_256_bits_here_1234567890
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_256_bits_here_0987654321
JWT_ACCESS_TOKEN_EXPIRY=3600000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# 7. Cloudinary (Audio & Avatar Storage)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# 8. Gemini & AI Chat Services (xah.io / OpenAI compatible)
GEMINI_API_KEY=your_gemini_or_xah_api_key_here
AI_CHAT_URL=https://api.xah.io/v1/chat/completions
AI_CHAT_API_KEY=your_ai_chat_api_key_here
AI_CHAT_MODEL=thanhnhan9023/gemini-3.7-flash-high

# 9. Speech-to-Text (Vilao AI Whisper / OpenAI Whisper)
WHISPER_URL=https://api.vilao.ai/v1/audio/transcriptions
WHISPER_API_KEY=your_whisper_api_key_here
WHISPER_MODEL=tsa/groq/whisper-large-v3
WHISPER_LANGUAGE=en

# 10. Text-to-Speech (TTS)
TTS_URL=https://api.xah.io/v1/audio/speech
TTS_API_KEY=your_tts_api_key_here
TTS_MODEL=namth/grok-voice-latest
TTS_VOICE=alloy

# 11. Speaking Storage
SPEAKING_STORAGE_TYPE=local
SPEAKING_AUDIO_STORAGE_PATH=D:/vocabulary-ai-uploads/audio

# 12. Payment Module (PayOS VietQR)
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_SANDBOX=true
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYMENT_RETURN_URL=http://localhost:5173/payment/success
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel

# 13. Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# 14. Application & OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
APP_NAME=VocabularyAI
LOG_LEVEL=INFO
